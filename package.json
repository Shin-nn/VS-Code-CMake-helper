          "default": "auto",
          "enumDescriptions": [
            "The first installed of C/C++, CodeLLDB, LLDB DAP",
            "C/C++ (gdb, or lldb on macOS)",
            "C/C++ with the Visual Studio debugger",
            "CodeLLDB",
            "LLDB DAP"
