        "cmakeHelper.gdbConfigurations": {
          "type": "array",
          "default": [],
          "scope": "resource",
          "markdownDescription": "GDB server configurations, as CLion's *Embedded GDB Server* and *Remote GDB Server*: chosen in the target picker, they're what Build, ▶ Run (Download & Run, or run over SSH) and 🐞 Debug act on. Edited in **CMake: Edit GDB Server Configurations…**. `${program}`, `${sourceDir}`, `${buildDir}`, `${targetDir}` and `${env:X}` are expanded.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "kind"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "embedded",
                  "remote"
                ],
                "enumDescriptions": [
                  "A GDB server started here (OpenOCD, J-Link, ST-LINK, pyOCD…), the program flashed",
                  "A gdbserver elsewhere; optionally uploaded and started over SSH"
                ]
              },
              "target": {
                "type": "string",
                "description": "The CMake target debugged (and flashed or uploaded). Empty: the active target."
              },
              "program": {
                "type": "string",
                "description": "Another file instead of the target's executable."
              },
              "debugger": {
                "type": "string",
                "description": "gdb for the target's architecture (gdb-multiarch, arm-none-eabi-gdb…)."
              },
              "remote": {
                "type": "string",
                "description": "What 'target remote' gets, e.g. localhost:3333."
              },
              "server": {
                "type": "string",
                "description": "Embedded: the GDB server program started first."
              },
              "serverArgs": {
                "type": "string"
              },
              "serverReady": {
                "type": "string",
                "description": "Embedded: a regular expression the server prints once it listens."
              },
              "serverEnvironment": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "download": {
                "type": "string",
                "enum": [
                  "always",
                  "updated",
                  "never"
                ],
                "default": "always"
              },
              "resetCommand": {
                "type": "string",
                "description": "Embedded: e.g. monitor reset halt; before and after the download."
              },
              "runCommands": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Embedded, Download & Run: gdb commands that start the program after the download (default: monitor reset run)."
              },
              "sysroot": {
                "type": "string"
              },
              "pathMappings": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Remote: build path → local path."
              },
              "ssh": {
                "type": "string",
                "description": "Remote: user@host to upload the program to and start gdbserver on."
              },
              "remotePath": {
                "type": "string"
              },
              "gdbserver": {
                "type": "string"
              },
              "args": {
                "type": "string"
              },
              "initCommands": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "connectCommands": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "buildBeforeDebug": {
                "type": "boolean",
                "default": true
              }
            }
          }
        },
